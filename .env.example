# Vercel: create a private Blob store and connect it to this project.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# A random secret of at least 32 bytes; never commit a real value.
AUTH_SECRET=
# Direct Google Gemini. Keep this key on the server, never in NEXT_PUBLIC_*.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
# Gateway is optional and disabled by default. A Google key works independently.
AI_GATEWAY_DISABLED=true
AI_GATEWAY_API_KEY=
# Global daily limit across all accounts; each user also has a 15/day limit.
AI_DAILY_LIMIT=200
TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe
# Local development only. Never used when VERCEL is set.
LOCAL_DATA_DIR=/tmp/polka-local-data
# YooKassa: all values server-only. Begin with enabled=false until the live launch is ready.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_ENABLED=false
YOOKASSA_TEST_MODE=false
APP_URL=https://study-shelf-three.vercel.app
# Owner console: an existing account ID is preferred. Username enrollment freezes the ID on first access.
OWNER_USER_ID=
OWNER_USERNAME=
